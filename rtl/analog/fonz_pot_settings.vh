// VR1: player bike size (IC9, upper shape PROMs IC86/IC87; larger = smaller bike), 10k rheostat
function integer pot_vr1(input integer code);
    case (code)
    0: pot_vr1 = 1800;
    1: pot_vr1 = 1000;
    2: pot_vr1 = 1200;
    3: pot_vr1 = 1500;
    4: pot_vr1 = 2200;
    5: pot_vr1 = 3300;
    6: pot_vr1 = 5000;
    7: pot_vr1 = 10000;
    default: pot_vr1 = 1800;
    endcase
endfunction
